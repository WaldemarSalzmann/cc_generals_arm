--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -116,6 +116,14 @@ if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|arm)" AND (CMAKE_CXX_COMPILER
     add_compile_options(-fsigned-char)
 endif()
 
+# The game libraries reference each other in a cycle (e.g. z_gameengine needs symbols from
+# z_gameenginedevice, which is linked before it). GNU ld resolves static libraries in one pass,
+# so let it rescan the whole library list until every symbol is found.
+if(UNIX AND NOT APPLE AND NOT CMAKE_CXX_COMPILER_LINKER_ID MATCHES "LLD|MOLD")
+    set(CMAKE_CXX_LINK_EXECUTABLE
+        "<CMAKE_CXX_COMPILER> <FLAGS> <CMAKE_CXX_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> -Wl,--start-group <LINK_LIBRARIES> -Wl,--end-group")
+endif()
+
 add_subdirectory(Dependencies)
 
 add_subdirectory(resources)
