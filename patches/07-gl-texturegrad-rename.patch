+#if defined(GGC_BGFX_RENDERER_GL)
+// shaderc's GLSL optimizer emits "textureGradARB" for texture2DGrad in GLSL 1.40 output, a name no
+// GL driver knows. Rename it to the core "textureGrad", padded to the same length so the shader
+// binary's size fields stay valid.
+static const bgfx::Memory * MakeShaderMemory(const uint8_t * data, uint32_t size)
+{
+    const bgfx::Memory * mem = bgfx::copy(data, size);
+    static const char kFrom[] = "textureGradARB";
+    static const char kTo[]   = "textureGrad   ";
+    const uint32_t len = sizeof(kFrom) - 1;
+    for (uint32_t i = 0; i + len <= mem->size; ++i)
+    {
+        if (std::memcmp(mem->data + i, kFrom, len) == 0)
+        {
+            std::memcpy(mem->data + i, kTo, len);
+            i += len - 1;
+        }
+    }
+    return mem;
+}
+#else
+static const bgfx::Memory * MakeShaderMemory(const uint8_t * data, uint32_t size)
+{
+    return bgfx::makeRef(data, size);
+}
+#endif
