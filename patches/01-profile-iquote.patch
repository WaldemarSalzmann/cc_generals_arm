diff --git a/Core/Libraries/Source/profile/CMakeLists.txt b/Core/Libraries/Source/profile/CMakeLists.txt
index 6f90157..f0fa0de 100644
--- a/Core/Libraries/Source/profile/CMakeLists.txt
+++ b/Core/Libraries/Source/profile/CMakeLists.txt
@@ -28,7 +28,11 @@ if(NOT WIN32)
     target_include_directories(core_profile_legacy BEFORE PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/../WWVegas/compat/win32_shims
         ${CMAKE_CURRENT_SOURCE_DIR}/../WWVegas
-        ${CMAKE_CURRENT_SOURCE_DIR}/../debug/Include
+    )
+    # Quote-only search path: as a normal -I directory its debug/debug.h shadows libstdc++'s
