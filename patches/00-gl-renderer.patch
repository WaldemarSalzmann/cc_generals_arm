diff --git a/cmake/bgfx.cmake b/cmake/bgfx.cmake
index 7a89964..4a4b01c 100644
--- a/cmake/bgfx.cmake
+++ b/cmake/bgfx.cmake
@@ -155,6 +155,11 @@ function(ggc_compile_bgfx_shader source_sc)
         set(_shader_suffix "spirv")
         set(_shader_platform "linux")
         set(_shader_profile "spirv")
+    elseif(GGC_BGFX_RENDERER STREQUAL "gl")
+        # GLSL 1.40 = OpenGL 3.1, the highest desktop GL that Panfrost offers on Mali-G52
+        set(_shader_suffix "glsl")
+        set(_shader_platform "linux")
+        set(_shader_profile "140")
     else()
         set(_shader_suffix "dx11")
         set(_shader_platform "windows")
diff --git a/cmake/render-backend.cmake b/cmake/render-backend.cmake
index 36d7717..d9351b1 100644
--- a/cmake/render-backend.cmake
+++ b/cmake/render-backend.cmake
@@ -68,20 +68,24 @@ if(GGC_RENDER_BACKEND STREQUAL "bgfx")
             set(GGC_BGFX_RENDERER "dx11" CACHE STRING "bgfx renderer for GGC_RENDER_BACKEND=bgfx")
         endif()
     endif()
-    set_property(CACHE GGC_BGFX_RENDERER PROPERTY STRINGS dx11 metal vulkan)
+    set_property(CACHE GGC_BGFX_RENDERER PROPERTY STRINGS dx11 metal vulkan gl)
 
     if(NOT GGC_BGFX_RENDERER STREQUAL "dx11" AND
        NOT GGC_BGFX_RENDERER STREQUAL "metal" AND
-       NOT GGC_BGFX_RENDERER STREQUAL "vulkan")
+       NOT GGC_BGFX_RENDERER STREQUAL "vulkan" AND
+       NOT GGC_BGFX_RENDERER STREQUAL "gl")
         message(FATAL_ERROR
             "Invalid GGC_BGFX_RENDERER: '${GGC_BGFX_RENDERER}'. "
-            "Must be one of: dx11, metal, vulkan.")
+            "Must be one of: dx11, metal, vulkan, gl.")
     endif()
 
     if(GGC_BGFX_RENDERER STREQUAL "metal")
         add_compile_definitions(GGC_BGFX_RENDERER_METAL=1)
     elseif(GGC_BGFX_RENDERER STREQUAL "vulkan")
         add_compile_definitions(GGC_BGFX_RENDERER_VULKAN=1)
+    elseif(GGC_BGFX_RENDERER STREQUAL "gl")
+        # OpenGL for GPUs without a usable Vulkan driver (e.g. Mali-G52 on Panfrost: GL 3.1 / GLES 3.1)
+        add_compile_definitions(GGC_BGFX_RENDERER_GL=1)
     else()
         add_compile_definitions(GGC_BGFX_RENDERER_DX11=1)
     endif()
